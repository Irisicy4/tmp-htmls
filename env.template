# Copy to .env and fill in your keys. .env is gitignored.
#
#   cp env.template .env && $EDITOR .env
#
# Used by harbor_runner.sh (Docker & Modal).

# Required — API key passed as OPENAI_API_KEY (works with OpenAI directly or
# any OpenAI-compatible proxy like UniAPI that routes to Anthropic, Google, etc.)
OPENAI_API_KEY=sk-your-api-key

# Optional — proxy endpoint. Omit to use OpenAI directly.
# With UniAPI you can use any model (Claude, Gemini, etc.) via the OpenAI API format.
# LLM_BASE_URL=https://api.uniapi.io/v1

# Optional — model override. Default: gpt-4.1-mini (from config)
# LLM_MODEL=claude-sonnet-4-20250514
