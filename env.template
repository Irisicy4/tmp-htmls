# Copy to .env and fill in your keys. .env is gitignored.
#
#   cp env.template .env && $EDITOR .env

# ── Option A: UniAPI (simplest — one key for all agents + judge) ──
# UNIAPI_KEY=uni-xxx
# UNIAPI_BASE=https://api.uniapi.io

# ── Option B: Direct provider APIs ──
# OPENAI_API_KEY=sk-xxx            # codex, aider (also used by judge if JUDGE_API_KEY not set)
# ANTHROPIC_API_KEY=sk-ant-xxx     # claude-code
# GEMINI_API_KEY=AIza-xxx          # gemini-cli

# ── Judge (LLM evaluator) ──
# Only needed if running a non-OpenAI agent without UniAPI.
# The judge always uses the OpenAI SDK, so it needs an OpenAI-compatible key.
# JUDGE_API_KEY=sk-xxx
# JUDGE_BASE_URL=                  # Leave empty to use OpenAI directly
