# Copy to .env and fill in your keys. .env is gitignored.
#
# cp env.template .env
# edit .env

# Required for agent and LLM-as-judge verifier
OPENAI_API_KEY=sk-your-openai-key

# Optional: use a proxy (e.g. UniAPI)
# LLM_BASE_URL=https://api.uniapi.io/v1

# Optional: override model (any model supported by the endpoint)
# LLM_MODEL=claude-sonnet-4-20250514

# Required for ENV=modal (cloud runs). Get from https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
